# API Configuration
# Shared backend via Cloudflare tunnel (no /api suffix — routes are /events, /auth/login, etc.)
VITE_API_BASE_URL=https://ticketremasterapi.hong-yi.me
# Local Minikube alternative: VITE_API_BASE_URL=http://localhost:8000

# Kong API Gateway key (matches frontend_app consumer in kong.yml)
VITE_KONG_API_KEY=tk_front_123456789

# Stripe Configuration (test mode)
VITE_STRIPE_PUBLIC_KEY=pk_test_change_me

# Sentry Error Tracking
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=1.0.0

# PostHog Analytics
VITE_POSTHOG_API_KEY=phc_change_me
VITE_POSTHOG_HOST=https://us.i.posthog.com

# WebSocket Configuration
VITE_WS_URL=wss://ticketremasterapi.hong-yi.me
