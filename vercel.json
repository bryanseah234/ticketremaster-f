{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|stitch-media/|favicon.ico|robots.txt|manifest.webmanifest|.*\\.(?:js|css|png|svg|jpg|jpeg|gif|webp|woff|woff2|ttf|map)$).*)",
      "destination": "/index.html"
    }
  ]
}
